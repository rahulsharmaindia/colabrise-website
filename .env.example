# Base URL of the nanoboost NestJS API (no /api/v1 prefix — routes are literal,
# e.g. /api/brand/register, /api/auth/google/start). Mirrors colabrise-web's
# VITE_API_URL and flutterapp's SERVER_URL --dart-define convention.
#
# Local dev — run `npm run dev` in nanoboost/ first:
VITE_API_URL=http://localhost:3000

# Production (Railway) — same deployment the Flutter app points to by default:
# VITE_API_URL=https://nanoboost-production.up.railway.app
